{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "训练室",
  "mainBinaryName": "训练室",
  "version": "../package.json",
  "identifier": "io.github.arknights.trainingroom",
  "build": {
    "frontendDist": "../dist/desktop",
    "beforeBuildCommand": "node scripts/prepare-native.mjs",
    "beforeDevCommand": "node scripts/prepare-native.mjs",
    "features": [
      "desktop"
    ]
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' http://atr-resource.localhost data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'",
      "capabilities": [
        {
          "identifier": "main",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:event:allow-listen",
            "core:event:allow-unlisten"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "../build/icon.ico",
      "../build/icon.png"
    ],
    "resources": {
      "../dist/resource/snapshot/": "training-room-resource/",
      "../dist/THIRD_PARTY_LICENSES.txt": "THIRD_PARTY_LICENSES.txt",
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "both",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "template": "../build/nsis/installer.nsi"
      }
    }
  }
}
